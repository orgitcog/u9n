{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unreal-Echo Development Roadmap Schema",
  "description": "Schema for generating GitHub issues and tracking progress across multiple organizations",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "organizations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "github_org": { "type": "string" },
              "role": { "enum": ["primary", "contributor", "observer"] },
              "repos": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name", "github_org", "role"]
          }
        }
      },
      "required": ["name", "code", "version"]
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^E[0-9]+$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "duration_months": { "type": "integer" },
          "status": { "enum": ["planned", "in_progress", "completed", "blocked"] },
          "priority": { "enum": ["critical", "high", "medium", "low"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "assigned_orgs": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "duration_weeks": { "type": "integer" },
                "status": { "enum": ["planned", "in_progress", "completed", "blocked"] },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string", "pattern": "^F[0-9]+\\.[0-9]+\\.[0-9]+$" },
                      "title": { "type": "string" },
                      "description": { "type": "string" },
                      "status": { "enum": ["planned", "in_progress", "review", "completed", "blocked"] },
                      "priority": { "enum": ["critical", "high", "medium", "low"] },
                      "effort_points": { "type": "integer", "minimum": 1, "maximum": 21 },
                      "assignees": { "type": "array", "items": { "type": "string" } },
                      "labels": { "type": "array", "items": { "type": "string" } },
                      "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
                      "technical_notes": { "type": "string" },
                      "related_features": { "type": "array", "items": { "type": "string" } },
                      "blocking_features": { "type": "array", "items": { "type": "string" } }
                    },
                    "required": ["id", "title", "description"]
                  }
                }
              },
              "required": ["id", "title", "features"]
            }
          }
        },
        "required": ["id", "title", "phases"]
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
          "description": { "type": "string" }
        },
        "required": ["name", "color"]
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "epic_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["title", "epic_ids"]
      }
    }
  },
  "required": ["project", "epics"]
}
